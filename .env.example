# Zumbido 05 - Configuracion de entorno (Python FastAPI + SQLAlchemy)
PORT=8000
APP_ENV=development
JWT_SECRET=cambia-esta-clave-secreta-en-produccion-por-una-muy-larga
CORS_ORIGIN=*

# Base de datos local por defecto (SQLite en modo WAL, cero configuracion):
DATABASE_URL=sqlite:///./data/zumbido05.db

# Ejemplos para produccion (instala psycopg[binary] o pymysql segun el motor):
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/zumbido05
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/zumbido05
